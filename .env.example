# Keyless by design. Nothing here is needed to run the app on Anna.

# executas/tokenbrief — all optional; defaults are compiled in (ch06 §6.10)
COINGECKO_API_KEY=            # optional demo key for local runs only; never shipped
CG_PER_MINUTE=5               # keyless CoinGecko origin budget (measured ~5/min, D-17)
DS_PER_MINUTE=240
CG_MIN_INTERVAL_MS=500
DS_MIN_INTERVAL_MS=250
HTTP_TIMEOUT_MS=8000
TOKENBRIEF_DEBUG=0            # 1 = verbose stderr logs in the Executa
TOKENBRIEF_EVIDENCE=0         # 1 = write raw upstream responses to evidence/

# ui — baked in at build time by Vite
# The Executa tool_id is NOT set here: `anna-app dev` / `anna-app apps publish` write
# bundle/anna-tool-ids.js (window.__ANNA_TOOL_IDS__.tokenbrief). VITE_TOKENBRIEF_TOOL_ID
# is only a fallback for runs without that sidecar.
VITE_TOKENBRIEF_TOOL_ID=tool-dev-tokenbrief
VITE_SHARE_LINK=https://tokenbrief-anna.vercel.app/?utm_source=share
VITE_DEFAULT_LANG=en
VITE_LLM_MAX_TOKENS=1200
VITE_LLM_TEMPERATURE=0.3
VITE_SYNTH_RETRIES=1
VITE_BRIEF_TEXT_TTL_S=1800

# scripts/ only (never shipped)
CMC_API_KEY=
